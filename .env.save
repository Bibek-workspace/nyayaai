# ─── Application ─────────────────────────────
APP_NAME=NyayaAI
ENVIRONMENT=development          # development | staging | production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Security ────────────────────────────────
JWT_SECRET_KEY=test-secret-key-12345678901234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────
POSTGRES_USER=nyayaai
POSTGRES_PASSWORD=nyayaai_dev_pwd
POSTGRES_DB=nyayaai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./backend/nyayaai.db

# ─── Redis ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── AI / OpenAI ─────────────────────────────
OPENAI_API_KEY=test-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DI# ─── Object storage (S3-compatible) ──────────
S3_ENDPOINT_URL=http://minio:9000        # Leave blank in prod for AWS S3
S3_BUCKET=nyayaai-documents
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_REGION=ap-south-1

# ───x Email (SMTP) ────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.xxxxx
EMAIL_FROM=no-reply@nyayaai.in
EMAIL_FROM_NAME=NyayaAI

# ─── SMS (Twilio) ────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+14155552671

# ─── OCR ─────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=eng+hin
